---
import Reveal from './Reveal.tsx';
import Divider from './motifs/Divider.astro';
import EventCard from './EventCard.astro';
import SprigGrowing from './SprigGrowing.tsx';
---

<section id="schedule" class="section-grad-b section-divider relative px-6 py-24 sm:py-32">
  <div class="relative z-0 mx-auto max-w-6xl">
    <div class="pointer-events-none absolute left-0 top-[-10px] -z-10 hidden aspect-[407/193] w-56 sm:block md:w-[480px]">
      <SprigGrowing client:only="react" />
    </div>
    <div class="pointer-events-none absolute right-0 top-[40px] -z-10 hidden aspect-[407/193] w-56 -scale-x-100 -scale-y-100 sm:block md:w-[460px]">
      <SprigGrowing client:only="react" />
    </div>

    <Reveal client:visible className="text-center">
      <p class="font-sans text-xs tracking-[0.35em] uppercase text-leaf-700/80">Schedule</p>
      <Divider class="mt-4 text-gold-500" />
      <h2 class="font-display mt-6 text-4xl text-ink sm:text-5xl">Two Days, Countless Memories</h2>
    </Reveal>

    <div class="mt-16 grid gap-8 md:grid-cols-3">
      <Reveal client:visible delay={0}>
        <EventCard
          eyebrow="Friday Evening"
          title="Mehendi"
          date="November 13, 2026"
          time="4:00 – 7:00 PM"
          place="Outdoor Pavilion, Harding Allen Estate"
          description="An evening of henna, color, and music to kick off the celebrations, come comfortable and ready to play games."
          dressCode="Vibrant colors, Indian attire"
        />
      </Reveal>

      <Reveal client:visible delay={0.1}>
        <EventCard
          eyebrow="Saturday Morning"
          title="Wedding Ceremony"
          date="November 14, 2026"
          time="9:30 AM – 12:00 PM"
          place="The Walled Garden, Harding Allen Estate"
          description="A beautiful blend of Kashmiri and Maharashtrian traditions in the estate's walled garden, followed by lunch with our guests."
          dressCode="Pastels, Indian attire"
        />
      </Reveal>

      <Reveal client:visible delay={0.2}>
        <EventCard
          eyebrow="Saturday Evening"
          title="Reception"
          date="November 14, 2026"
          time="5:00 – 10:00 PM"
          place="The Grand Ballroom, Harding Allen Estate"
          description="An evening of drinks, dinner and dancing under the chandeliers of the Grand Ballroom."
          dressCode="Black tie, Indo-Western attire"
        />
      </Reveal>
    </div>
  </div>
</section>

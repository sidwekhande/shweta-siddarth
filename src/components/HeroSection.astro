---
import Hero from './Hero.tsx';
import FloralBanner from './FloralBanner.tsx';
---

<section id="home" class="relative flex min-h-screen items-center justify-center overflow-hidden bg-gradient-to-b from-blush-50 via-ivory to-leaf-50">
  <div class="pointer-events-none absolute inset-x-0 top-0 z-0 mx-auto w-full max-w-4xl opacity-80 aspect-[900/240]">
    <FloralBanner client:only="react" />
  </div>

  <Hero client:load />

  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-0 mx-auto w-full max-w-4xl -scale-y-100 opacity-80 aspect-[900/240]">
    <FloralBanner client:only="react" />
  </div>

  <div class="absolute bottom-10 left-1/2 flex -translate-x-1/2 flex-col items-center gap-2 text-ink/40">
    <span class="font-sans text-[10px] tracking-[0.3em] uppercase">Scroll</span>
    <span class="h-8 w-px bg-ink/30"></span>
  </div>
</section>

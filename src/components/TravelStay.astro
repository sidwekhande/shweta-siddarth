---
import Reveal from './Reveal.tsx';
import Divider from './motifs/Divider.astro';

const address = '59 Allen Drive, Barre, MA 01005';
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`Harding Allen Estate, ${address}`)}`;
const mapsEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(address)}&output=embed`;
---

<section id="travel" class="section-grad-b section-divider px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-5xl">
    <Reveal client:visible className="text-center">
      <p class="font-sans text-xs tracking-[0.35em] uppercase text-leaf-700/80">Travel &amp; Stay</p>
      <Divider class="mt-4 text-gold-500" />
      <h2 class="font-display mt-6 text-4xl text-ink sm:text-5xl">Harding Allen Estate</h2>
    </Reveal>

    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <Reveal client:visible>
        <div class="h-full rounded-3xl border border-gold-500/20 bg-white/60 p-8">
          <p class="font-sans text-base leading-relaxed text-ink/80">
            A neoclassical mansion built in the 1920s, set on grounds with English-style
            walled gardens, a classic fountain, and the Grand Ballroom, just outside Barre,
            Massachusetts.
          </p>
          <p class="mt-4 font-sans text-base tracking-[0.05em] text-ink/70">{address}</p>

          <a
            href={mapsUrl}
            target="_blank"
            rel="noreferrer"
            class="mt-6 inline-block rounded-full border border-gold-500/60 px-6 py-2.5 font-sans text-xs tracking-[0.25em] uppercase text-gold-700 transition-colors hover:bg-gold-500/10"
          >
            Get Directions
          </a>
        </div>
      </Reveal>

      <Reveal client:visible delay={0.1}>
        <div class="h-full min-h-[280px] overflow-hidden rounded-3xl border border-gold-500/20">
          <iframe
            title="Map to Harding Allen Estate"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            src={mapsEmbedUrl}
            class="h-full w-full min-h-[280px] grayscale-[15%]"
          ></iframe>
        </div>
      </Reveal>
    </div>

    <Reveal client:visible delay={0.15} className="mt-8">
      <div class="grid gap-8 text-left sm:grid-cols-2">
        <div class="rounded-2xl border border-gold-500/20 bg-white/60 p-6">
          <h3 class="font-display text-xl text-ink">Where to Stay</h3>
          <p class="mt-2 font-sans text-base leading-relaxed text-ink/80">
            A handful of hotels and Airbnbs can be found about 30 minutes away in
            Worcester, MA. Some options are: the Homewood Suites by Hilton, Residence Inn
            by Marriott, and the AC Hotel by Marriott.
          </p>
          <p class="mt-3 font-sans text-base leading-relaxed text-ink/80">
            Shrewsbury, Marlborough, and Westborough are also nearby with additional
            options.
          </p>
        </div>
        <div class="rounded-2xl border border-gold-500/20 bg-white/60 p-6">
          <h3 class="font-display text-xl text-ink">Parking</h3>
          <p class="mt-2 font-sans text-base leading-relaxed text-ink/80">
            Ample free parking is available on site, with guides on hand to direct
            you to your spot.
          </p>
        </div>
      </div>
    </Reveal>
  </div>
</section>

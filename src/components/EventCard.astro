---
interface Props {
  eyebrow: string;
  title: string;
  date: string;
  time: string;
  place: string;
  description: string;
  dressCode: string;
}
const { eyebrow, title, date, time, place, description, dressCode } = Astro.props;
---

<div class="flex h-full flex-col items-center rounded-3xl border border-gold-500/20 bg-white/60 px-8 py-10 text-center shadow-[0_20px_60px_-30px_rgba(169,132,26,0.35)] backdrop-blur-sm">
  <div class="text-gold-600">
    <slot name="motif" />
  </div>
  <p class="mt-4 font-sans text-[11px] tracking-[0.3em] uppercase text-leaf-700/80">{eyebrow}</p>
  <h3 class="font-display mt-2 text-3xl text-ink">{title}</h3>
  <p class="mt-3 font-sans text-base tracking-[0.15em] uppercase text-gold-700">{date}</p>
  <p class="font-sans text-base text-ink/70">{time}</p>
  <p class="mt-1 font-sans text-base text-ink/70">{place}</p>
  <p class="mt-4 font-sans text-base leading-relaxed text-ink/80">{description}</p>
  <div class="mt-5 border-t border-gold-500/20 pt-4">
    <p class="font-sans text-[10px] tracking-[0.25em] uppercase text-leaf-700/70">Dress Code</p>
    <p class="mt-1 font-sans text-base text-ink/80">{dressCode}</p>
  </div>
</div>

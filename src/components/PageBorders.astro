---
// Decorative paisley rails down the left/right margins, visible on large
// screens only — narrower viewports don't have enough side margin outside
// the sections' content columns to show these without overlapping text.
const columnOffsets = ['0px', '16px', '32px'];
---

<div class="pointer-events-none fixed inset-0 z-30 hidden 2xl:block" aria-hidden="true">
  <div class="absolute inset-y-0 left-2 flex gap-2">
    {columnOffsets.map((offset) => (
      <div
        class="h-full w-6 opacity-70"
        style={`background-image: url(/motifs/paisley.svg); background-repeat: repeat-y; background-size: 24px auto; background-position: top ${offset} left;`}
      />
    ))}
  </div>

  <div class="absolute inset-y-0 right-2 flex gap-2">
    {columnOffsets.map((offset) => (
      <div
        class="h-full w-6 -scale-x-100 opacity-70"
        style={`background-image: url(/motifs/paisley.svg); background-repeat: repeat-y; background-size: 24px auto; background-position: top ${offset} left;`}
      />
    ))}
  </div>
</div>

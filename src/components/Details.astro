---
import Reveal from './Reveal.tsx';
import Divider from './motifs/Divider.astro';

const items = [
  {
    title: 'Attire',
    description:
      "Mehendi: vibrant colors, comfortable Indian attire. Ceremony: traditional Indian attire, semi-formal. Reception: formal — Indian or Western formalwear both welcome. [Edit to match your preferences.]",
  },
  {
    title: 'Weather',
    description:
      'Mid-November in Massachusetts is crisp. The ceremony is outdoors in the walled garden with an indoor backup — bring a light coat for the morning.',
  },
  {
    title: 'Getting There',
    description:
      "Harding Allen Estate is about 20 minutes from Worcester, MA. See Travel & Stay above for accommodation options.",
  },
  {
    title: 'Plus-Ones & Kids',
    description: '[Edit this with your own plus-one / children policy — the RSVP form can be adjusted to match.]',
  },
] as const;
---

<section id="details" class="section-grad-a section-divider px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-4xl">
    <Reveal client:visible className="text-center">
      <p class="font-sans text-xs tracking-[0.35em] uppercase text-leaf-700/80">Guest Notes</p>
      <Divider class="mt-4 text-gold-500" />
      <h2 class="font-display mt-6 text-4xl text-ink sm:text-5xl">Helpful Details</h2>
    </Reveal>

    <div class="mt-14 grid gap-6 sm:grid-cols-2">
      {
        items.map((item, i) => (
          <Reveal client:visible delay={i * 0.08}>
            <div class="h-full rounded-2xl border border-gold-500/20 bg-white/60 p-6">
              <h3 class="font-display text-xl text-ink">{item.title}</h3>
              <span class="mt-2 block h-px w-10 bg-gold-500/50" />
              <p class="mt-3 font-sans text-sm leading-relaxed text-ink/80">{item.description}</p>
            </div>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>

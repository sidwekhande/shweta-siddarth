---
import Reveal from './Reveal.tsx';
import Divider from './motifs/Divider.astro';
import Countdown from './Countdown.tsx';
---

<section class="section-grad-a section-divider relative overflow-hidden px-6 py-20 sm:py-24">
  <div class="relative mx-auto max-w-2xl text-center">
    <Reveal client:visible>
      <p class="font-sans text-xs tracking-[0.35em] uppercase text-leaf-700/80">Counting Down</p>
      <Divider class="mt-4 text-gold-500" />
      <h2 class="font-display mt-6 text-3xl text-ink sm:text-4xl">Until the Celebrations Begin</h2>

      <div class="mt-10 inline-block rounded-3xl border border-gold-500/25 bg-white/50 px-6 py-8 sm:px-10">
        <Countdown client:load />
      </div>
    </Reveal>
  </div>
</section>

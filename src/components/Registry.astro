---
import Reveal from './Reveal.tsx';
import Divider from './motifs/Divider.astro';
---

<section id="registry" class="section-grad-b section-divider px-6 py-24 sm:py-32">
  <div class="relative z-10 mx-auto max-w-2xl text-center">
    <Reveal client:visible>
      <p class="font-sans text-xs tracking-[0.35em] uppercase text-leaf-700/80">Registry</p>
      <Divider class="mt-4 text-gold-500" />
      <h2 class="font-display mt-6 text-4xl text-ink sm:text-5xl">A Gift for Us</h2>
      <p class="mt-6 font-sans text-base leading-relaxed text-ink/80">
        Your presence at our celebrations is the greatest gift of all. For those who wish
        to give more, we're registered at Zola.
      </p>
      <a
        href="https://www.zola.com/registry/shwetaandsiddarth"
        target="_blank"
        rel="noreferrer"
        class="mt-6 inline-block rounded-full border border-gold-500/60 px-8 py-3 font-sans text-xs tracking-[0.25em] uppercase text-gold-700 transition-colors hover:bg-gold-500/10"
      >
        View Registry
      </a>
    </Reveal>
  </div>
</section>

---
import Reveal from './Reveal.tsx';
import Divider from './motifs/Divider.astro';
---

<section id="registry" class="section-grad-b section-divider px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-2xl text-center">
    <Reveal client:visible>
      <p class="font-sans text-xs tracking-[0.35em] uppercase text-leaf-700/80">Registry</p>
      <Divider class="mt-4 text-gold-500" />
      <h2 class="font-display mt-6 text-4xl text-ink sm:text-5xl">A Gift for Us</h2>
      <p class="mt-6 font-sans text-base leading-relaxed text-ink/80">
        Your presence at our celebrations is the greatest gift of all. Registry details
        coming soon — [add your registry link(s) here].
      </p>
    </Reveal>
  </div>
</section>

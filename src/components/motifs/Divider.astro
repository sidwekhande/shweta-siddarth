---
interface Props {
  class?: string;
}
const { class: className = 'text-gold-500' } = Astro.props;
---

<svg
  class={`mx-auto h-6 w-40 ${className}`}
  viewBox="0 0 200 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.2"
  stroke-linecap="round"
  xmlns="http://www.w3.org/2000/svg"
>
  <path d="M0 12 H78" opacity="0.8" />
  <path d="M122 12 H200" opacity="0.8" />
  <path d="M100 12 C 94 4 84 4 82 12 C 84 20 94 20 100 12 Z" />
  <path d="M100 12 C 106 4 116 4 118 12 C 116 20 106 20 100 12 Z" />
  <circle cx="100" cy="12" r="2" fill="currentColor" stroke="none" />
</svg>
